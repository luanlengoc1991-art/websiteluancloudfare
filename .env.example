# Dữ liệu và file nằm trong Cloudflare D1 và R2, cấu hình qua binding trong
# wrangler.jsonc. Chỉ những biến dưới đây cần đặt thủ công.

# Email Google duy nhất được cấp quyền quản trị.
ALPHA_ADMIN_EMAIL=

# OAuth client của Google dùng cho đăng nhập. Redirect URI phải là
# https://<tên-miền>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Đăng nhập mật khẩu quản trị dự phòng; mặc định tắt.
ALPHA_ENABLE_PASSWORD_LOGIN=false
ALPHA_ADMIN_PASSWORD_HASH=

# Chỉ đặt khi chạy local qua HTTP. Trên Cloudflare để trống (cookie luôn HTTPS).
# ALPHA_SECURE_COOKIE=false

# Chỉ đặt khi tên miền công khai khác Host của request.
# ALPHA_PUBLIC_ORIGIN=
\n\n# Claude API dùng cho mục AI sửa website trong Admin.\n# Chỉ đặt ở secret/runtime environment, không commit giá trị thật.\nANTHROPIC_API_KEY=\n