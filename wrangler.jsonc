{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "websiteluancloudfare",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  // Plain variables live here so a deploy cannot drop them; secrets stay in Worker settings.
  "vars": {
    "ALPHA_ENABLE_PASSWORD_LOGIN": "true"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "websiteluancloudfare"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alpha-hub",
      "database_id": "1f376627-9f4a-4072-8dbc-35953670880e",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "alpha-assets"
    }
  ],
  "observability": {
    "enabled": true
  }
}
